{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "epoque-motors",
  "compatibility_date": "2026-11-14",
  // Le site est statique : Cloudflare sert dist/ tel quel. Le script ne reçoit que /api/* (formulaire de
  // demande, envoyé par e-mail via Resend : src/worker/).
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  },
  // RESEND_API_KEY est un secret : `npx wrangler secret put RESEND_API_KEY` (ou tableau de bord Cloudflare).
  "vars": {
    "ENQUIRY_TO": "epoquemotors@gmail.com",
    "ENQUIRY_FROM": "Époque Motors <formulaire@epoquemotors.fr>"
  },
  // Au plus 5 demandes par minute et par adresse IP.
  "ratelimits": [
    { "name": "ENQUIRY_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
