{
  "name": "epoque-motors",
  "version": "0.1.0",
  "description": "ÉPOQUE MOTORS — premium vintage automotive experiences in Paris",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/seo/build.tsx && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "vitest run --coverage",
    "test:e2e": "node tests/run.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kizem/vintage-cars.git"
  },
  "bugs": {
    "url": "https://github.com/Kizem/vintage-cars/issues"
  },
  "homepage": "https://github.com/Kizem/vintage-cars#readme",
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0",
    "wrangler": "4.162.0"
  },
  "private": true,
  "type": "module"
}
